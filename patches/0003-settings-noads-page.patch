+not_null<Button*> AddToggle(
+		not_null<Window::Controller*> window,
+		not_null<Ui::VerticalLayout*> container,
+		const char *optionId) {
+	auto &option = base::options::lookup<bool>(optionId);
+	const auto name = option.name().isEmpty()
+		? QString::fromUtf8(optionId)
+		: option.name();
+
+	Ui::AddSkip(container, st::settingsCheckboxesSkip);
+	const auto toggles = container->lifetime().make_state<
+		rpl::event_stream<bool>>();
+	const auto button = container->add(object_ptr<Button>(
+		container,
+		rpl::single(name),
+		st::settingsButtonNoIcon
+	))->toggleOn(toggles->events_starting_with(option.value()));
+
+	const auto restarter = option.restartRequired()
+		? button->lifetime().make_state<base::Timer>()
+		: nullptr;
+	if (restarter) {
+		restarter->setCallback([=] {
+			window->show(Ui::MakeConfirmBox({
+				.text = tr::lng_settings_need_restart(),
+				.confirmed = [] { Core::Restart(); },
+				.confirmText = tr::lng_settings_restart_now(),
+				.cancelText = tr::lng_settings_restart_later(),
+			}));
+		});
+	}
+
+	button->toggledChanges(
+	) | rpl::on_next([=, &option](bool toggled) {
+		if (option.value() != toggled) {
+			option.set(toggled);
+		}
+		if (restarter) {
+			restarter->callOnce(st::settingsButtonNoIcon.toggle.duration);
+		}
+	}, button->lifetime());
+
+	return button;
+}
+
+void AddStringField(
+		not_null<Ui::VerticalLayout*> container,
+		const char *optionId) {
+	auto &option = base::options::lookup<QString>(optionId);
+	const auto title = option.name().isEmpty()
+		? QString::fromUtf8(optionId)
+		: option.name();
+
+	const auto field = container->add(
+		object_ptr<Ui::InputField>(
+			container,
+			st::defaultInputField,
+			rpl::single(title),
+			option.value()),
+		style::margins(22, 6, 22, 6));
+
+	field->submits(
+	) | rpl::on_next([=, &option] {
+		option.set(field->getLastText().trimmed());
+	}, field->lifetime());
+
+	field->changes(
+	) | rpl::on_next([=, &option] {
+		option.set(field->getLastText());
+	}, field->lifetime());
+}
+
+} // namespace
+
+NoAds::NoAds(
+		QWidget *parent,
+		not_null<Window::SessionController*> controller)
+: Section(parent, controller) {
+	::NoAds::Ai::RegisterOptions();
+	setupContent();
+}
+
+rpl::producer<QString> NoAds::title() {
+	return rpl::single(u"去广告 / AI / 语音"_q);
+}
+
+void NoAds::setupContent() {
+	const auto content = Ui::CreateChild<Ui::VerticalLayout>(this);
+	const auto window = &controller()->window();
+
+	Ui::AddSkip(content);
+	Ui::AddSubsectionTitle(content, rpl::single(u"基础功能"_q));
+
+	AddToggle(window, content, "noads-disable-ads");
+	AddToggle(window, content, "noads-local-premium");
+
+	Ui::AddSkip(content, st::settingsCheckboxesSkip);
+	Ui::AddDividerText(
+		content,
+		rpl::single(u"仅本客户端生效。本地大会员不解锁服务端鉴权功能（如大文件上传），修改后建议重启客户端。"_q));
+
+	Ui::AddSkip(content);
+	Ui::AddDivider(content);
+	Ui::AddSkip(content);
+
+	Ui::AddSubsectionTitle(content, rpl::single(u"AI 翻译（OpenAI 兼容）"_q));
+
+	const auto aiToggle = AddToggle(window, content, "noads-ai-translate");
+
+	const auto aiWrap = content->add(
+		object_ptr<Ui::SlideWrap<Ui::VerticalLayout>>(
+			content,
+			object_ptr<Ui::VerticalLayout>(content)));
+	const auto aiInner = aiWrap->entity();
+
+	Ui::AddSkip(aiInner, 4);
+	AddStringField(aiInner, "noads-ai-base-url");
+	AddStringField(aiInner, "noads-ai-api-key");
+	AddStringField(aiInner, "noads-ai-model");
+	AddStringField(aiInner, "noads-ai-system-prompt");
+	Ui::AddSkip(aiInner, 4);
+
+	aiWrap->toggle(base::options::lookup<bool>("noads-ai-translate").value(), anim::type::instant);
+	aiToggle->toggledChanges(
+	) | rpl::on_next([=](bool toggled) {
+		aiWrap->toggle(toggled, anim::type::normal);
+	}, aiWrap->lifetime());
+
+	Ui::AddSkip(content, st::settingsCheckboxesSkip);
+	Ui::AddDividerText(
+		content,
+		rpl::single(u"开启后聊天翻译走 OpenAI 兼容 chat/completions 接口。需自备 API Key。Base URL 留空默认使用官方 OpenAI 地址。"_q));
+
+	Ui::AddSkip(content);
+	Ui::AddDivider(content);
+	Ui::AddSkip(content);
+
+	Ui::AddSubsectionTitle(content, rpl::single(u"自定义语音转写 STT"_q));
+
+	const auto sttToggle = AddToggle(window, content, "noads-stt-enable");
+
+	const auto sttWrap = content->add(
+		object_ptr<Ui::SlideWrap<Ui::VerticalLayout>>(
+			content,
+			object_ptr<Ui::VerticalLayout>(content)));
+	const auto sttInner = sttWrap->entity();
+
+	Ui::AddSkip(sttInner, 4);
+	AddStringField(sttInner, "noads-stt-base-url");
+	AddStringField(sttInner, "noads-stt-api-key");
+	AddStringField(sttInner, "noads-stt-model");
+	Ui::AddSkip(sttInner, 4);
+
+	sttWrap->toggle(base::options::lookup<bool>("noads-stt-enable").value(), anim::type::instant);
+	sttToggle->toggledChanges(
+	) | rpl::on_next([=](bool toggled) {
+		sttWrap->toggle(toggled, anim::type::normal);
+	}, sttWrap->lifetime());
+
+	Ui::AddSkip(content, st::settingsCheckboxesSkip);
+	Ui::AddDividerText(
+		content,
+		rpl::single(u"优先使用 /audio/transcriptions 接口。以上配置留空时自动复用上方 AI 翻译设置。"_q));
+
+	Ui::AddSkip(content);
+	Ui::AddDividerText(
+		content,
+		rpl::single(u"非官方构建。API Key 仅安全保存在本机实验配置中，不会向任何云端上传。"_q));
+
+	Ui::ResizeFitChild(this, content);
+}
+
+Type NoAdsId() {
+	return NoAds::Id();
+}
+
+} // namespace Settings
